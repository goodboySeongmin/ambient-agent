{
  "manifest_version": 3,
  "name": "Ambient Agent Observer",
  "version": "0.2.0",
  "description": "Understands browser activity and proactively offers help when the user appears stuck.",
  "permissions": [
    "tabs",
    "activeTab",
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ambient Agent"
  }
}