{
  "manifest_version": 3,
  "name": "Ambient Agent Observer",
  "version": "0.1.0",
  "description": "Captures browser activity for Ambient Agent.",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ambient Agent"
  }
}